# Copy to .env (or set these in your MCP client config) and fill in.
#
# One-time Salesforce setup: create a connected app with OAuth enabled and the
# "Manage Pardot services (pardot_api)" scope — see the README.

# Connected app consumer key/secret (Setup -> App Manager -> your app ->
# Manage Consumer Details). Aliases: SALESFORCE_CLIENT_ID / _SECRET.
PARDOT_CLIENT_ID=3MVG9...
PARDOT_CLIENT_SECRET=...

# Account Engagement business unit id (18 chars, starts with 0Uv).
# Salesforce Setup -> quick-find "Business Unit Setup".
PARDOT_BUSINESS_UNIT_ID=0Uv...

# --- Choose ONE auth flow ----------------------------------------------------
# 1) Client credentials (recommended, headless): enable "Client Credentials
#    Flow" on the connected app with a run-as user that has Account Engagement
#    access. Nothing else to set — the two vars above are enough.
#
# 2) Refresh token: run `pardot-mcp-auth` once (browser login) to cache a token
#    at PARDOT_TOKEN_PATH — or paste an existing refresh token here.
# PARDOT_REFRESH_TOKEN=
#
# 3) Static access token (quick tests only; expires and cannot refresh).
# PARDOT_ACCESS_TOKEN=

# Where `pardot-mcp-auth` caches its token. Must be writable.
# PARDOT_TOKEN_PATH=~/.config/pardot-mcp/token.json

# Salesforce login host. Sandboxes use https://test.salesforce.com; a My Domain
# URL (https://yourcompany.my.salesforce.com) also works.
# SALESFORCE_LOGIN_URL=https://login.salesforce.com

# Pardot API host. Account Engagement sandbox/demo orgs use
# https://pi.demo.pardot.com.
# PARDOT_BASE_URL=https://pi.pardot.com

# Local callback port for `pardot-mcp-auth`. The connected app must list
# http://localhost:<port>/callback as a callback URL.
# PARDOT_OAUTH_REDIRECT_PORT=8721

# Optional space/comma-separated OAuth scopes for `pardot-mcp-auth`. Omit to
# request every scope granted to the connected app.
# PARDOT_OAUTH_SCOPES=pardot_api refresh_token
